# ArchMind AI - Environment Configuration
APP_NAME="ArchMind AI - Evidence-Driven Agentic Software Architect"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# Gemini API Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Database Configuration
# For local Docker PostgreSQL with pgvector:
# DATABASE_URL="postgresql+psycopg://archmind:archmind_secret@localhost:5432/archmind_db"
# Fallback local SQLite (automatic when PostgreSQL is not configured/reachable):
DATABASE_URL="sqlite:///./archmind.db"

# RAG & Embeddings
EMBEDDING_DIMENSION=768
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

